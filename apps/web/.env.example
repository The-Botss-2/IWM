NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_PATH=/api/v1

# Web Push public key for browser notifications. MUST be byte-identical to the
# API's VAPID_PUBLIC_KEY (see root .env.example). NEXT_PUBLIC_* is inlined at
# BUILD time, so this has to be present here when `next build` runs - setting it
# only in the API/root env or the runtime env will NOT reach the browser bundle.
# Leave blank to disable closed-tab push; in-app/foreground call banners still
# work without it (they only need the service worker, which now registers
# regardless of VAPID).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Domain that cPanel-managed mailboxes live under (mirrors the API's
# CPANEL_DOMAIN). Unset = no one is offered self-serve mailbox setup.
NEXT_PUBLIC_CPANEL_DOMAIN=

# Primary admin address (mirrors the API's ADMIN_EMAIL) so the users page
# shows that account as protected. Unset = none shown as protected.
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# IMAP/SMTP hosts pre-filled in the Add mail account form. Unset = empty fields.
NEXT_PUBLIC_MAIL_DEFAULT_IMAP_HOST=
NEXT_PUBLIC_MAIL_DEFAULT_SMTP_HOST=
