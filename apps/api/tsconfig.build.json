{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // Explicit even though no level in the inheritance chain currently sets
    // `noEmit: true` - a defensive guard against a future base-config edit
    // silently turning emit off here.
    "noEmit": false
  },
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts", "**/*.e2e-spec.ts"]
}
