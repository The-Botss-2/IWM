{
  "name": "@botss/database",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "push": "prisma db push",
    "format": "prisma format",
    "validate": "prisma validate",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" tsc -p tsconfig.build.json",
    "dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "echo 'no eslint yet' && exit 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo 'no tests yet' && exit 0",
    "clean": "rimraf dist .turbo *.tsbuildinfo || exit 0",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.15"
  }
}
