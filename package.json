{
  "name": "iwm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build --concurrency=4",
    "dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" turbo run dev --concurrency=10",
    "start": "turbo run start --concurrency=4",
    "start:api": "pnpm --filter @botss/api run start",
    "start:web": "pnpm --filter @botss/web run start",
    "lint": "turbo run lint --concurrency=4",
    "test": "turbo run test --concurrency=4",
    "typecheck": "turbo run typecheck --concurrency=4",
    "verify": "turbo run typecheck lint test --concurrency=4",
    "knip": "knip",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "db:generate": "pnpm --filter @botss/database run generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @botss/database run migrate",
    "db:studio": "dotenv -e .env -- pnpm --filter @botss/database run studio",
    "db:seed:dev": "cross-env NODE_ENV=development ALLOW_SEED=true dotenv -e .env -- pnpm --filter @botss/database run seed",
    "db:push": "dotenv -e .env -- pnpm --filter @botss/database run push",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.4",
    "knip": "5.63.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "prisma": "^5.22.0",
    "turbo": "^2.11.10",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "better-auth": "1.7.7",
    "zod": "3.24.1"
  },
  "pnpm": {
    "overrides": {
      "zod@<4": "3.24.1",
      "better-auth": "1.7.7",
      "multer": "^2.5.0",
      "ws@>=8.0.0": "^8.21.0",
      "socket.io-parser": "^4.2.7",
      "tar@>=7.0.0": "^7.5.21",
      "proxy-addr": "^2.0.8",
      "engine.io": "^6.6.10",
      "compression": "^1.8.2",
      "lodash": "^4.18.0",
      "linkify-it": "^5.0.1",
      "prosemirror-view": "^1.42.3",
      "fast-uri": "^3.1.9",
      "nanoid@>=3.0.0 <4.0.0": "^3.3.16",
      "undici@>=6.0.0 <7.0.0": "^6.27.0",
      "ip-address@>=10.0.0": "^10.3.1",
      "source-map-js": "^1.2.2",
      "shell-quote": "^1.11.0",
      "brace-expansion@>=1.0.0 <2.0.0": "^1.1.16",
      "picomatch@>=4.0.0": "^4.0.4",
      "glob@>=10.0.0 <11.0.0": "^10.5.0",
      "js-yaml@>=3.0.0 <4.0.0": "^3.15.0",
      "form-data@>=3.0.0 <4.0.0": "^3.0.5",
      "postcss": "^8.5.32",
      "browserslist": "^4.28.7",
      "brace-expansion@>=2.0.0 <3.0.0": "^2.1.7",
      "brace-expansion@>=3.0.0 <6.0.0": "^5.0.12",
      "js-yaml@>=4.0.0 <5.0.0": "^4.3.2",
      "qs@>=6.0.0 <7.0.0": "^6.16.2",
      "body-parser@>=1.0.0 <2.0.0": "^1.20.9",
      "form-data@>=4.0.0 <5.0.0": "^4.0.6",
      "postcss-selector-parser@>=6.0.0 <7.0.0": "^6.1.5",
      "markdown-it@>=14.0.0 <15.0.0": "^14.3.3",
      "file-type@>=20.0.0 <22.0.0": "^21.3.4",
      "@xmldom/xmldom@>=0.9.0 <0.10.0": "^0.9.12",
      "fflate@>=0.8.0 <0.9.0": "^0.8.3",
      "ajv@>=8.0.0 <9.0.0": "^8.20.0",
      "webpack@>=5.0.0 <6.0.0": "^5.112.2",
      "@xmldom/xmldom@>=0.7.0 <0.9.0": "^0.8.15",
      "sharp@<0.35.5": "^0.35.5",
      "tmp@<0.2.6": "^0.2.7",
      "uuid@<11.1.1": "^11.1.1"
    }
  }
}
