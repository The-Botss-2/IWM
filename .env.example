# ════════════════════════════════════════════════════════════════════════════
# THIS FILE IS A TEMPLATE - never write real secrets here, even commented out.
# Production secrets live in the host environment (systemd unit, process
# manager config, container secrets, a secrets manager, etc.) - never on disk in
# the repo and never in CI. .env.production is git-ignored as a belt-and-suspenders
# measure.
# ════════════════════════════════════════════════════════════════════════════

# Postgres (used by packages/database, apps/api)
# Host port 5433 because docker-compose maps 5433:5432 to avoid clashing with
# other local Postgres instances. Change to 5432 if you bind compose differently.
DATABASE_URL=postgresql://botss:botss@localhost:5433/botss?schema=public
# Connection pool: Prisma defaults to (2 x CPU cores + 1) connections per
# process. In production set it explicitly so every API process (x cluster
# instances) plus migrations stays under Postgres `max_connections`, e.g.
#   ...?schema=public&connection_limit=20&pool_timeout=20
# Rule of thumb: connection_limit ~ (max_connections - 10) / process_count,
# usually 10-30. AuthGuard resolves a request's context with up to 4 queries
# in parallel, so keep it at least 10.

# Web-facing app URL used to build invitation/reset links. In production set to
# https://app.example.com (no trailing slash). Used by the API only.
PUBLIC_APP_URL=http://localhost:3000

# Redis (cache, BullMQ queues) - host port 6380 in compose to avoid 6379 clashes.
REDIS_URL=redis://localhost:6380

# Better Auth
# Generate a 32-byte secret: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-me-with-32-byte-hex-secret
# Public URL the API is reachable at from browsers. Must be HTTPS in production
# so session cookies can be marked Secure (required by SameSite=None).
BETTER_AUTH_URL=http://localhost:4000
# Parent domain for the session cookie when API and web live on different
# subdomains (e.g. api.example.com + app.example.com). Leave blank in local dev.
# Use a leading dot to scope to all subdomains: .example.com
AUTH_COOKIE_DOMAIN=
# Session cookie name prefix. Leave blank in production (changing it signs
# everyone out). A staging install on the same parent domain sets its own, e.g.
# iwm-staging, so the two never overwrite each other's cookie.
AUTH_COOKIE_PREFIX=

# API
API_PORT=4000
API_BASE_PATH=/api/v1
# Comma-separated list of origins allowed to make credentialed requests.
WEB_ORIGIN=http://localhost:3000
# Minimum log level the API emits. One of: verbose | debug | log | warn | error | fatal.
# Everything at or above the chosen level is logged. Leave blank to use the
# default (debug in development, log in production - i.e. no debug noise when
# deployed). Set LOG_LEVEL=debug to bring back the chatty diagnostics (session
# context, socket connect/disconnect, IMAP sync no-ops) for a debugging session.
LOG_LEVEL=
# Process role: all (default) | api | worker. Read from the real process
# environment only (never from this file), so set it in your process manager.
# `api` + `worker` run as a pair: HTTP/Socket.IO in one, BullMQ workers, IMAP
# IDLE and crons in exactly one other. The worker serves a health check on
# WORKER_HEALTH_PORT.
# ROLE=all
# Address of the primary admin account; the admin panel refuses to demote or
# delete it. Unset = no account is protected. (Set NEXT_PUBLIC_ADMIN_EMAIL in
# apps/web to the same value so the UI matches.)
ADMIN_EMAIL=admin@example.com

# Timesheet warnings (daily HR nudges for employees who stop posting
# timesheets). Off unless BOTH are set. HR_EMAIL_DOMAIN picks the organization
# (by its email domain) and limits who is scanned and notified;
# HR_SENDER_EMAIL is an existing user the warnings are sent from.
HR_EMAIL_DOMAIN=
HR_SENDER_EMAIL=

# Payslips: who signs the platform (root) organization's own payslips. Unset
# name = no signatory block. Other organizations never get it.
PAYSLIP_SIGNATORY_NAME=
PAYSLIP_SIGNATORY_TITLE=
# Where the payslip template lives. Defaults to apps/api/payslip-templates/default.
# PAYSLIP_TEMPLATES_DIR=

# Chatbot lead intake (public website -> POST /api/v1/leads/external).
# Authenticates an HMAC-signed body (no session); the workspace + creating user
# are FIXED from these vars, so a leaked secret can only create WEBSITE/NEW leads
# in this one workspace - never elsewhere, never impersonating a real user.
# Provision them by creating a "Website Leads" workspace in the app and a
# no-login bot user that is a member of it; put their ids here.
# CHATBOT_INTAKE_SECRET must equal the HMAC secret your website signs with.
# Leave blank to keep the endpoint disabled (returns 503).
CHATBOT_INTAKE_SECRET=
CHATBOT_INTAKE_WORKSPACE_ID=
CHATBOT_INTAKE_USER_ID=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_PATH=/api/v1
# Public origin of the web app. Used by Next.js metadataBase so OG / Twitter
# image URLs resolve absolutely. Set to the deployed origin in production.
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# SMTP for system email (workspace invitations, invoices sent from the platform).
# Production: a dedicated no-reply mailbox or a transactional relay, e.g.
#   SMTP_HOST=mail.example.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=no-reply@example.com
#   MAIL_FROM="IWM <no-reply@example.com>"
# System email NEVER falls back to a personal mailbox. When SMTP_HOST is blank
# only organizations with their own mail config can send; everything else is
# logged instead of sent (fine for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# From address for system email. Unset = no-reply@localhost.
MAIL_FROM="IWM <no-reply@example.com>"
# Set to `true` to skip the boot-time SMTP verify. Use when you KNOW the SMTP
# creds are wrong and don't want every restart to count as another failed
# login against your mail host's cPHulk / fail2ban threshold (which can
# auto-ban the whole API server's IP). Per-send retries still surface the
# error in the worker logs. Set back to false once the creds work.
SMTP_SKIP_VERIFY=false

# Reverse proxy hops in front of the API (Caddy = 1). Rate limiters key on the
# client IP; without this every request looks like 127.0.0.1.
TRUST_PROXY_HOPS=1

# Largest single upload, in bytes (default 250 MB).
MAX_UPLOAD_BYTES=262144000
# Extra URL prefixes accepted for chat attachments besides S3_PUBLIC_URL and
# S3_ENDPOINT, comma separated. Usually left empty.
CHAT_ATTACHMENT_URL_PREFIXES=

# Invoice PDFs are rendered by the gotenberg container in docker-compose.yml.
GOTENBERG_URL=http://127.0.0.1:3100
# Where invoice templates live. Defaults to apps/api/invoice-templates.
# INVOICE_TEMPLATES_DIR=

# S3-compatible object storage (MinIO local on 9100 / R2 prod)
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=botss-local
S3_SECRET_ACCESS_KEY=botss-local-secret
S3_BUCKET=botss-files
S3_FORCE_PATH_STYLE=true
# Public-read URL base. Leave unset for local MinIO (S3_ENDPOINT is used).
# Set to your CDN host in production (e.g. R2 custom domain).
# S3_PUBLIC_URL=https://files.example.com
# Public URL path shape. `true` (default) builds `<host>/<bucket>/<key>` -
# MinIO and the R2 raw S3 API both want this. `false` builds `<host>/<key>`
# without the bucket segment - required when the public host is a custom
# CNAME that already maps to one specific R2 bucket. Setting this wrong
# is the "File wasn't available on site" symptom: paths 404 because R2's
# custom-domain endpoint doesn't expect the bucket in the URL path.
# S3_PUBLIC_URL_INCLUDES_BUCKET=false

# Mail (per-user IMAP/SMTP accounts - Phase 1 mail client)
# Required. 64 hex characters (32 bytes). Generate via:
#   openssl rand -hex 32
# This key encrypts the IMAP/SMTP password ciphertext stored in MailAccount.
# Rotating it requires re-encrypting every existing MailAccount, so do not
# change it on an install that already has mail accounts.
MAIL_ENCRYPTION_KEY=
# IMAP/SMTP hosts used when the server auto-provisions a mail account for a
# cPanel-managed user (admin create/import, self-serve mailbox setup). Unset =
# no auto-provisioning; users add mailboxes manually. (The web form's pre-fill
# is NEXT_PUBLIC_MAIL_DEFAULT_IMAP_HOST / _SMTP_HOST in apps/web.)
MAIL_DEFAULT_IMAP_HOST=
MAIL_DEFAULT_SMTP_HOST=
# IMAP sync tuning. Messages fetched per round trip, most imported per run (the
# rest continue in the background), and the size above which only a message's
# text parts are downloaded instead of the full source with attachments.
MAIL_SYNC_BATCH=25
MAIL_INITIAL_SYNC_LIMIT=200
MAIL_MAX_SOURCE_BYTES=15728640
# Outbound user mail sends in parallel on its own queue.
MAIL_SEND_CONCURRENCY=5

# Optional outbound SMTP relay.
# When set, ALL outbound user mail is delivered through this relay instead of
# each account's own cPanel SMTP. Useful when the mail host rate-limits the API
# server's IP. (AWS itself only restricts port 25; 465 and 587 are open.) The relay forwards our raw MIME unchanged, so threading and the
# Sent-folder copy are preserved; the From stays the user's address. Point it
# at a reputable free relay on an open port and authorize the sending domain
# (add the relay's SPF + DKIM DNS records for your domain):
#   - Brevo:   smtp-relay.brevo.com   port 587   (300 emails/day free)
#   - SMTP2GO: mail.smtp2go.com       port 2525  (1,000 emails/month free)
#   - Amazon SES SMTP: email-smtp.<region>.amazonaws.com port 587
# Leave MAIL_RELAY_HOST blank to keep using each account's own SMTP.
# (Transactional email can use the same relay by pointing SMTP_* above at it.)
MAIL_RELAY_HOST=
MAIL_RELAY_PORT=587
MAIL_RELAY_SECURE=false
MAIL_RELAY_USER=
MAIL_RELAY_PASSWORD=

# LiveKit (Phase 3 - group calls + voice channels).
# Self-hosted LiveKit server running on Docker. The API mints JWT access
# tokens; clients connect directly to LIVEKIT_URL over WebSocket + UDP.
# Generate the key/secret pair with `livekit-server generate-keys` or set
# them in the LiveKit server's config.yaml - both sides must match.
#
# LIVEKIT_URL is the wss:// (TLS) or ws:// (local dev) endpoint the
# client connects to. Example: wss://livekit.example.com
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# cPanel UAPI (for the admin Users panel - auto-provisions / rotates / imports
# mailboxes via Email::add_pop, Email::passwd_pop, Email::list_pops_with_disk).
# Leave any of these blank to disable cPanel integration; the admin Users
# panel still works, it just won't touch the webmail server.
#
# CPANEL_HOST is the cPanel server hostname (often the same as the mail host,
# e.g. cpanel.example.com). CPANEL_USER is the cPanel account that owns the
# domain (not the email - the cPanel account). CPANEL_API_TOKEN is created
# in cPanel → Manage API Tokens with at least Email scope. CPANEL_DOMAIN is
# the domain mailboxes live under (e.g. example.com).
CPANEL_HOST=
CPANEL_PORT=2083
CPANEL_USER=
CPANEL_API_TOKEN=
CPANEL_DOMAIN=

# Web Push (browser notifications when the CRM tab is closed/backgrounded).
# Generate a keypair once:  npx web-push generate-vapid-keys
# All THREE server vars must be set or the API logs "Web Push disabled" and
# never sends push (see apps/api/src/notifications/notifications-push.service.ts).
# VAPID_SUBJECT is a mailto: (or https) contact URL the push services require.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# CLIENT side: the browser reads a SEPARATE, NEXT_PUBLIC_-prefixed copy of the
# PUBLIC key. It MUST equal VAPID_PUBLIC_KEY above. Because NEXT_PUBLIC_* vars
# are inlined into the web bundle at BUILD time (not read at runtime), this
# must live in apps/web's env (apps/web/.env.local or .env.production) when
# `next build` runs - NOT only in the API/root .env or the runtime env.
# See apps/web/.env.example.
# (set NEXT_PUBLIC_VAPID_PUBLIC_KEY in apps/web - documented there)

# Phase 2 placeholders (Polar invoicing)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# Phase 3 placeholders (LiveKit / Twilio)

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ════════════════════════════════════════════════════════════════════════════
# Desktop and mobile shells. These are read by those apps, not by the API.
# ════════════════════════════════════════════════════════════════════════════
# Desktop (Electron), read at run time from the process environment:
#   BOTSS_APP_URL            web app the window loads. Unset = http://localhost:3000.
#   BOTSS_APP_EXTRA_ORIGINS  comma-separated extra origins that stay in the
#                            window (e.g. an old domain). Unset = none.
# Mobile (Expo), inlined at build time; put them in apps/mobile/.env:
#   EXPO_PUBLIC_APP_URL             web app the WebView loads. Unset =
#                                   http://localhost:3000 (simulator only).
#   EXPO_PUBLIC_APP_LEGACY_ORIGINS  comma-separated extra origins kept in the
#                                   WebView. Unset = none.
#   EXPO_PUBLIC_EAS_PROJECT_ID      Expo (EAS) project id for native push
#                                   tokens. Unset = native push off.
